# Copy public build settings to .env.toss. Never use a VITE_ prefix for a secret.
VITE_API_ORIGIN=https://your-api-domain.example
TOSS_APP_NAME=mal-sai
# Server-only settings. Store the real file outside public/ and dist/.
APP_PLATFORM=toss
API_PUBLIC_ORIGIN=https://your-api-domain.example
# Required exact TLS reverse-proxy peer IP as seen by the API server.
# That proxy must overwrite X-Real-IP; never pass through client-provided values.
# Keep the backend port private and preserve the original Host header.
TRUSTED_PROXY_IP=
TOSS_CERT_PATH=
TOSS_KEY_PATH=
STORAGE_KEY=
DATA_DIRECTORY=/data
OPENAI_API_KEY=
AI_ENABLED=true
AI_BUDGET_USD=3
AI_DAILY_REQUEST_LIMIT=30
AI_MINUTE_REQUEST_LIMIT=6
AI_MAX_CONCURRENT_REQUESTS=3
PORT=3000
# Release checklist, never set true before completing each review.
SUPPORT_EMAIL=
PRIVACY_REVIEWED=false
TOSS_DEVICE_TESTED=false
