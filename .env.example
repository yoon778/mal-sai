# Copy to .env, add your key, and restart. Never put keys in browser code.
OPENAI_API_KEY=
# Both a key and this switch are required for paid requests.
AI_ENABLED=false
# Conservative local dollar ceiling; keep this below your remaining KRW budget.
# This is not a guarantee of the card's KRW settlement including taxes/FX.
AI_BUDGET_USD=3
PORT=3000
