# Web deployment. Real values belong in hosting secrets, never in public/ or Git.
APP_PLATFORM=web
NODE_ENV=production
# Render provides RENDER=true and RENDER_EXTERNAL_URL automatically.
# Set API_PUBLIC_ORIGIN only for a custom domain or another hosting provider.
API_PUBLIC_ORIGIN=
DATA_DIRECTORY=/var/data
STORAGE_KEY=
# First deployment is a demo without paid AI calls. Enable after release checks.
AI_ENABLED=false
OPENAI_API_KEY=
AI_BUDGET_USD=3
AI_DAILY_REQUEST_LIMIT=30
AI_MINUTE_REQUEST_LIMIT=6
AI_MAX_CONCURRENT_REQUESTS=3
# Non-Render hosting: exact TLS proxy IP, with X-Real-IP overwritten by that proxy.
TRUSTED_PROXY_IP=
SUPPORT_EMAIL=
PRIVACY_REVIEWED=false
